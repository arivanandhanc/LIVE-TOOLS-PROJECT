# Render sets NODE_ENV=production, and npm maps that to `omit=dev` — so
# `npm install` skips devDependencies. typescript, prisma and every @types/*
# package live there, so `npm run build` (prisma generate && tsc) then fails
# with "Cannot find name 'Buffer'/'process'", "Cannot find module 'fs'", etc.
# and the deploy dies before it ever starts.
#
# Forcing include=dev restores them at build time. Only the compiled dist/ is
# run in production, so this costs nothing at runtime.
include=dev
