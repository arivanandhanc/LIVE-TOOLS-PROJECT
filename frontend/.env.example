# Copy to .env.local for local development.
# Everything here is PUBLIC — NEXT_PUBLIC_* vars are inlined into the browser
# bundle. Never put a reCAPTCHA secret / API key or any other credential here.

# ── Site ──
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Backend origin. In the browser the app calls /api/* same-origin and Next
# proxies here (see rewrites in next.config.ts).
NEXT_PUBLIC_API_URL=http://localhost:4000

# ── Google reCAPTCHA ──
# Loaded on every page; a token is attached to every state-changing API call.
# `enterprise` uses recaptcha/enterprise.js, `classic` uses recaptcha/api.js.
# MUST match RECAPTCHA_MODE on the server, or tokens will fail verification.
NEXT_PUBLIC_RECAPTCHA_MODE=enterprise
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# ── Google AdSense ──
# Publisher id; the loader is injected on every page. Set to an empty string to
# disable ads entirely (e.g. on preview deployments).
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-8840337065465233

# ── IndexNow (optional, for scripts/indexnow.mjs) ──
# INDEXNOW_KEY=
